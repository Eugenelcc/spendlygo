{
  "name": "spendlygo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @spendlygo/server dev",
    "dev:miniapp": "pnpm --filter @spendlygo/miniapp dev",
    "build": "pnpm --filter @spendlygo/server build && pnpm --filter @spendlygo/miniapp build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @spendlygo/db generate",
    "db:migrate": "pnpm --filter @spendlygo/db migrate",
    "db:studio": "pnpm --filter @spendlygo/db studio",
    "db:seed": "pnpm --filter @spendlygo/db seed",
    "bot:set-webhook": "pnpm --filter @spendlygo/server set-webhook",
    "bot:delete-webhook": "pnpm --filter @spendlygo/server delete-webhook"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
