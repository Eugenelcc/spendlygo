# ---------------------------------------------------------------------------
# Spendlygo environment variables
# Copy to .env and fill in. NEVER commit .env  (see GUARDRAILS.md section 5)
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------

# BotFather token. Also used as the HMAC key for Mini App initData validation.
BOT_TOKEN=

# Random secret (>=32 chars) verified against the
# X-Telegram-Bot-Api-Secret-Token header on every webhook request.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Supabase TRANSACTION POOLER connection string (port 6543).
# Prepared statements are disabled in code because the pooler rejects them.
DATABASE_URL=

# Public origin of the deployed Mini App static site. Used in web_app buttons.
MINIAPP_URL=http://localhost:5173

# Public origin of this server. Used by the set-webhook script.
SERVER_URL=http://localhost:3000

# Bearer token guarding POST /tasks/tick. Generate with: openssl rand -hex 32
CRON_SECRET=

# Free API key from https://ocr.space/ocrapi (no credit card) for receipt
# amount pre-fill (F4.6, ADR 0005). Optional — photo attachments still work
# without it, just without the amount suggestion.
OCR_SPACE_API_KEY=

# Comma-separated Telegram user IDs allowed to use the bot while it is private.
# Leave empty to allow everyone (do NOT do this on the free tier).
ALLOWED_TELEGRAM_IDS=

# development | production
NODE_ENV=development

# Injected by Render in production.
PORT=3000

# Default timezone assigned to new users.
DEFAULT_TIMEZONE=Asia/Singapore

# The server registers its own Telegram webhook at boot when SERVER_URL is
# HTTPS, so deploying needs no local tooling. Set false when a tunnel points a
# development bot at localhost and you don't want the deployed URL overwritten.
AUTO_SET_WEBHOOK=true

# --- miniapp (PUBLIC - shipped to the browser, never put a secret here) -----

VITE_API_BASE_URL=http://localhost:3000
